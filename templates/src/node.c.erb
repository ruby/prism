#line <%= __LINE__ + 1 %> "prism/templates/src/<%= File.basename(__FILE__) %>"
#include "prism/internal/node.h"

#include "prism/internal/arena.h"

#include <stdlib.h>

/**
 * Attempts to grow the scratch list to the next size. If there is already
 * capacity in the list, this function does nothing. Otherwise it allocates a
 * new array from the arena (abandon-and-copy strategy) and copies the existing
 * data into it.
 */
static void
pm_scratch_node_list_grow(pm_arena_t *arena, pm_scratch_node_list_t *list, uint32_t size) {
    uint32_t requested_size = list->size + size;

    // Guard against overflow on the addition.
    if (requested_size < list->size) abort();

    // If the requested size is within the existing capacity, return.
    if (requested_size <= list->capacity) return;

    // Otherwise, compute the next capacity by doubling.
    uint32_t next_capacity = list->capacity == 0 ? 4 : list->capacity * 2;

    // Guard against overflow on the doubling.
    while (requested_size > next_capacity) {
        if (next_capacity == 0) abort();
        next_capacity *= 2;
    }

    // Allocate a new array from the arena (old array is abandoned).
    pm_node_t **nodes = (pm_node_t **) pm_arena_alloc(arena, sizeof(pm_node_t *) * next_capacity, PRISM_ALIGNOF(pm_node_t *));

    // Copy old data into the new array.
    if (list->size > 0) {
        memcpy(nodes, list->nodes, list->size * sizeof(pm_node_t *));
    }

    list->nodes = nodes;
    list->capacity = next_capacity;
}

/**
 * Slow path for pm_scratch_node_list_append: grow the list and append the
 * node. Do not call directly - use pm_scratch_node_list_append instead.
 */
void
pm_scratch_node_list_append_slow(pm_arena_t *arena, pm_scratch_node_list_t *list, pm_node_t *node) {
    pm_scratch_node_list_grow(arena, list, 1);
    list->nodes[list->size++] = node;
}

/**
 * Append every node of the other scratch list onto the end of the list.
 */
void
pm_scratch_node_list_concat(pm_arena_t *arena, pm_scratch_node_list_t *list, const pm_scratch_node_list_t *other) {
    if (other->size > 0) {
        pm_scratch_node_list_grow(arena, list, other->size);
        memcpy(list->nodes + list->size, other->nodes, other->size * sizeof(pm_node_t *));
        list->size += other->size;
    }
}

/**
 * Append a node onto the end of a node list. A node list's array is always
 * exactly its size, so it grows to exactly one more node, in place when it is
 * the most recent allocation in the arena and by copying it otherwise.
 */
void
pm_node_list_append(pm_arena_t *arena, pm_node_list_t *list, pm_node_t *node) {
    if (list->size == 0) {
        *list = pm_node_list_single(arena, node);
        return;
    }

    list->nodes = (pm_node_t **) pm_arena_realloc(arena, list->nodes, sizeof(pm_node_t *) * (list->size + 1), sizeof(pm_node_t *) * list->size, PRISM_ALIGNOF(pm_node_t *));
    list->nodes[list->size++] = node;
}

/**
 * Carve a new batch of chunks out of the arena and hand out its first one. The
 * arena only guarantees a new block's own alignment, so this over-allocates by
 * up to one chunk and rounds the start of the batch up by hand.
 */
static pm_node_chunk_t *
pm_node_chunks_carve(pm_node_chunks_t *chunks) {
    size_t alignment = PRISM_ALIGNOF(pm_node_chunk_t);
    size_t size = PM_NODE_CHUNK_BATCH * PM_NODE_CHUNK_SIZE + PM_NODE_CHUNK_SIZE - alignment;

    uintptr_t start = (uintptr_t) pm_arena_alloc(chunks->arena, size, alignment);
    pm_node_chunk_t *batch = (pm_node_chunk_t *) ((start + PM_NODE_CHUNK_MASK) & ~PM_NODE_CHUNK_MASK);

    chunks->next = batch + 1;
    chunks->end = batch + PM_NODE_CHUNK_BATCH;
    return batch;
}

/**
 * Get a chunk, preferring the most recently returned one since it is the most
 * likely to still be in cache, then the current batch, then a new batch.
 */
static PRISM_INLINE pm_node_chunk_t *
pm_node_chunk_acquire(pm_node_chunks_t *chunks) {
    pm_node_chunk_t *chunk = chunks->free;

    if (chunk != NULL) {
        chunks->free = chunk->prev;
        return chunk;
    }

    if (chunks->next != chunks->end) return chunks->next++;
    return pm_node_chunks_carve(chunks);
}

/**
 * Slow path for pm_node_list_open_append: link a new chunk onto the end of the
 * list and append the node to it. Do not call directly - use
 * pm_node_list_open_append instead.
 */
void
pm_node_list_open_append_slow(pm_node_chunks_t *chunks, pm_node_list_t *list, pm_node_t *node) {
    pm_node_chunk_t *chunk = pm_node_chunk_acquire(chunks);
    chunk->prev = list->nodes == NULL ? NULL : PM_NODE_CHUNK_OF(list->nodes - 1);
    chunk->slots[0] = node;

    list->nodes = &chunk->slots[1];
    list->size++;
}

/**
 * Copy an open list into an array of exactly its size allocated from the given
 * arena. Chunks are linked from the last one backward, so the array is filled
 * from its end. The whole chain then goes back on the freelist at once.
 */
void
pm_node_list_finalize(pm_node_chunks_t *chunks, pm_arena_t *arena, pm_node_list_t *list) {
    if (list->size == 0) return;

    pm_node_t **nodes = (pm_node_t **) pm_arena_alloc(arena, sizeof(pm_node_t *) * list->size, PRISM_ALIGNOF(pm_node_t *));
    pm_node_chunk_t *last = PM_NODE_CHUNK_OF(list->nodes - 1);
    pm_node_chunk_t *chunk = last;

    size_t count = (size_t) (list->nodes - chunk->slots);
    size_t offset = list->size;

    for (;;) {
        offset -= count;
        memcpy(nodes + offset, chunk->slots, count * sizeof(pm_node_t *));

        if (chunk->prev == NULL) break;
        chunk = chunk->prev;
        count = PM_NODE_CHUNK_SLOTS;
    }

    chunk->prev = chunks->free;
    chunks->free = last;
    list->nodes = nodes;
}

/**
 * A finalized list holding just the given node. A list with one node is known
 * to be complete when it is made, so it skips chunks entirely.
 */
pm_node_list_t
pm_node_list_single(pm_arena_t *arena, pm_node_t *node) {
    pm_node_t **nodes = (pm_node_t **) pm_arena_alloc(arena, sizeof(pm_node_t *), PRISM_ALIGNOF(pm_node_t *));
    nodes[0] = node;
    return (pm_node_list_t) { .size = 1, .nodes = nodes };
}

/**
 * Prepend a node onto the beginning of a finalized list. Every existing node
 * moves over by one, so the list is copied into a new array.
 */
void
pm_node_list_prepend_finalized(pm_arena_t *arena, pm_node_list_t *list, pm_node_t *node) {
    pm_node_t **nodes = (pm_node_t **) pm_arena_alloc(arena, sizeof(pm_node_t *) * (list->size + 1), PRISM_ALIGNOF(pm_node_t *));
    nodes[0] = node;

    if (list->size > 0) {
        memcpy(nodes + 1, list->nodes, sizeof(pm_node_t *) * list->size);
    }

    list->nodes = nodes;
    list->size++;
}

/**
 * Returns a string representation of the given node type.
 */
const char *
pm_node_type(pm_node_type_t node_type)
{
    switch (node_type) {
<%- nodes.each do |node| -%>
        case <%= node.type %>:
            return "<%= node.type %>";
<%- end -%>
    }
    return "";
}

/**
 * Visit each of the nodes in this subtree using the given visitor callback. The
 * callback function will be called for each node in the subtree, and its
 * return value determines whether the walk visits that node's children, skips
 * them, or stops entirely. The data parameter is treated as an opaque pointer
 * and is passed to the visitor callback for consumers to use as they see fit.
 */
bool
pm_visit_node(const pm_node_t *node, pm_visit_callback_t visitor, void *data) {
    pm_visit_result_t result = visitor(node, data);
    if (result == PM_VISIT_DESCEND) return pm_visit_child_nodes(node, visitor, data);
    return result != PM_VISIT_STOP;
}

/**
 * Visit the children of the given node with the given callback. This is the
 * default behavior for walking the tree that is called from pm_visit_node if
 * the callback returns PM_VISIT_DESCEND. A stop from any child returns false
 * immediately, so that it propagates up through every enclosing call.
 */
bool
pm_visit_child_nodes(const pm_node_t *node, pm_visit_callback_t visitor, void *data) {
    switch (PM_NODE_TYPE(node)) {
        <%- nodes.each do |node| -%>
        <%- if (fields = node.fields.select { |field| field.is_a?(Prism::Template::NodeField) || field.is_a?(Prism::Template::OptionalNodeField) || field.is_a?(Prism::Template::NodeListField) }).any? -%>
        case <%= node.type %>: {
            const pm_<%= node.human %>_t *cast = (const pm_<%= node.human %>_t *) node;
            <%- fields.each do |field| -%>

            // Visit the <%= field.name %> field
            <%- case field -%>
            <%- when Prism::Template::NodeField -%>
            if (!pm_visit_node((const pm_node_t *) cast-><%= field.name %>, visitor, data)) return false;
            <%- when Prism::Template::OptionalNodeField -%>
            if (cast-><%= field.name %> != NULL && !pm_visit_node((const pm_node_t *) cast-><%= field.name %>, visitor, data)) return false;
            <%- when Prism::Template::NodeListField -%>
            const pm_node_list_t *<%= field.name %> = &cast-><%= field.name %>;
            for (size_t index = 0; index < <%= field.name %>->size; index++) {
                if (!pm_visit_node(<%= field.name %>->nodes[index], visitor, data)) return false;
            }
            <%- end -%>
            <%- end -%>

            break;
        }
        <%- else -%>
        case <%= node.type %>:
            break;
        <%- end -%>
        <%- end -%>
        case PM_SCOPE_NODE:
            break;
    }

    return true;
}
<%- nodes.each do |node| -%>

<%- params = node.fields.map(&:c_param) -%>
/**
 * Allocate and initialize a new <%= node.name %> node.
 */
pm_<%= node.human %>_t *
pm_<%= node.human %>_new(pm_arena_t *arena, uint32_t node_id, pm_node_flags_t flags, pm_location_t location<%= params.empty? ? "" : ", #{params.join(", ")}" %>) {
    pm_<%= node.human %>_t *node = (pm_<%= node.human %>_t *) pm_arena_alloc(arena, sizeof(pm_<%= node.human %>_t), PRISM_ALIGNOF(pm_<%= node.human %>_t));

    *node = (pm_<%= node.human %>_t) {
        .base = { .type = <%= node.type %>, .flags = flags, .node_id = node_id, .location = location }<%= node.fields.empty? ? "" : "," %>
<%- node.fields.each_with_index do |field, index| -%>
        .<%= field.name %> = <%= field.name %><%= index < node.fields.size - 1 ? "," : "" %>
<%- end -%>
    };

    return node;
}
<%- end -%>
