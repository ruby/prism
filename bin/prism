#!/usr/bin/env ruby
# frozen_string_literal: true

$:.unshift(File.expand_path("../lib", __dir__))
require "prism"

module Prism
  class CLI
    def run(argv)
      case argv.shift
      when "bench"      then bench(argv)
      when "bundle"     then bundle(argv)
      when "console"    then console
      when "dot"        then dot(argv)
      when "encoding"   then encoding(argv)
      when "error"      then error(argv)
      when "keywords"   then keywords
      when "lex"        then lex(argv)
      when "lex_compat" then lex_compat(argv)
      when "locals"     then locals(argv)
      when "parse"      then parse(argv)
      when "parser"     then parser(argv)
      when "ripper"     then ripper(argv)
      when "rubyparser" then rubyparser(argv)
      when "repl"       then repl
      else
        puts <<~TXT
          Usage:
            bin/prism bench [file ...]
            bin/prism bundle [...]
            bin/prism console
            bin/prism dot [source]
            bin/prism encoding [encoding]
            bin/prism error [source]
            bin/prism keywords
            bin/prism lex [source]
            bin/prism lex_compat [source]
            bin/prism locals [source]
            bin/prism parse [source]
            bin/prism parser [source]
            bin/prism ripper [source]
            bin/prism rubyparser [source]
            bin/prism repl
        TXT
      end
    end

    private

    ############################################################################
    # Commands
    ############################################################################

    # bin/prism bench [file ...]
    # Measures raw parse throughput using Prism.profile (no Ruby AST creation).
    def bench(argv)
      require "benchmark/ips"

      files =
        if argv.any?
          argv.map { |path| [path, File.read(path)] }
        else
          Dir[File.join(__dir__, "../test/prism/fixtures/**/*.txt")].sort.map { |path| [path, File.read(path)] } +
            Dir[File.join(__dir__, "../lib/**/*.rb")].sort.map { |path| [path, File.read(path)] }
        end

      total_bytes = files.sum { |_, source| source.bytesize }
      puts "Benchmarking #{files.size} files (#{total_bytes} bytes total)"
      puts

      Benchmark.ips do |x|
        x.time = 10
        x.warmup = 3

        x.report("parse (all files)") do
          files.each { |_, source| Prism.profile(source) }
        end

        x.report("parse (fixtures only)") do
          files.each { |path, source| Prism.profile(source) if path.end_with?(".txt") }
        end
      end
    end

    # bin/prism bundle [...]
    def bundle(argv)
      [
        ["3.1", ["3.1"]],
        ["3.2", ["3.2"]],
        ["3.3", ["3.3"]],
        ["3.4", ["3.4", "typecheck"]],
        ["4.0", ["4.0"]],
        ["4.1", ["4.1"]],
      ].each do |ruby_version, gemfiles|
        gemfiles.each do |gemfile|
          system(
            { "BUNDLE_GEMFILE" => File.expand_path("../gemfiles/#{gemfile}/Gemfile", __dir__) },
            "chruby-exec", ruby_version, "--", "bundle", *argv,
            exception: true,
            chdir: File.expand_path("../", __dir__)
          )
        rescue RuntimeError => error
          warn("\e[31;m#{ruby_version} (#{gemfile}): #{error.message}\e[m")
        end
      end
    end

    # bin/prism console
    def console
      require "irb"
      IRB.start(__FILE__)
    end

    # bin/prism dot [source]
    def dot(argv)
      result = parse_source(argv)

      node = result.value
      path =
        if argv.first&.match?(/\A[\w\.]+\z/)
          argv.first.split(".")
        else
          %w[statements body first]
        end

      path.each do |field|
        node = node.public_send(field)
      end

      File.write(
        "out.svg",
        IO.popen("dot -Tsvg", "w+") do |file|
          file.write(node.to_dot)
          file.close_write
          file.read
        end
      )
    end

    # bin/prism encoding [encoding]
    def encoding(argv)
      found = Encoding.find(argv.shift)
      found = Encoding::ASCII_8BIT if found == Encoding::US_ASCII

      if !found.ascii_compatible?
        warn("Encoding `#{found.name}' is not ASCII compatible")
        exit(1)
      end

      lookup_table(found)
      unicode_lists if found == Encoding::UTF_8 || found == Encoding::UTF8_MAC
    end

    # bin/prism error [source]
    def error(argv)
      source, filepath = read_source(argv)
      result = Prism.parse(source)

      if result.errors.any?
        puts result.errors_format
      else
        puts "No syntax errors for #{filepath}"
      end
    end

    # bin/prism keywords
    # Searches for the multiplier that PM_KEYWORD_SLOT in src/prism.c uses to
    # give every keyword its own slot in the keyword table. Run this after
    # changing the set of keywords, and copy its output into src/prism.c.
    def keywords
      keywords = %w[
        __ENCODING__ __LINE__ __FILE__ BEGIN END alias and begin break case
        class def defined? do else elsif end ensure false for if in module next
        nil not or redo rescue retry return self super then true undef unless
        until when while yield
      ]

      # This must match PM_KEYWORD_SLOT_BITS in src/prism.c.
      slot_bits = 6

      # Pack each keyword the same way as PM_KEYWORD_PACK in src/prism.c: its
      # first, middle, and last bytes, and its length.
      packed = keywords.map do |keyword|
        bytes = keyword.bytes
        bytes[0] | (bytes[bytes.length / 2] << 8) | (bytes[-1] << 16) | (bytes.length << 24)
      end

      if packed.uniq.length != packed.length
        abort "Two keywords pack to the same value, so PM_KEYWORD_PACK needs to sample different bytes."
      end

      # Try random odd multipliers until one gives every keyword its own slot.
      # The generator is seeded so that the search always finds the same
      # multiplier. Each slot remembers the attempt that last claimed it, so
      # the slots do not need to be cleared between attempts.
      random = Random.new(1)
      claimed = Array.new(1 << slot_bits, 0)
      multiplier = nil
      attempts = 0

      until multiplier
        attempts += 1
        candidate = random.rand(1 << 32) | 1

        perfect = packed.all? do |value|
          slot = ((value * candidate) & 0xFFFFFFFF) >> (32 - slot_bits)
          next false if claimed[slot] == attempts
          claimed[slot] = attempts
        end

        multiplier = candidate if perfect
      end

      puts "Found a multiplier after #{attempts} attempts:"
      puts
      puts format("#define PM_KEYWORD_SLOT(packed) ((uint32_t) ((uint32_t) (packed) * 0x%08xU) >> (32 - PM_KEYWORD_SLOT_BITS))", multiplier)
      puts
      puts "The bytes that each keyword's entry in pm_keywords packs:"
      puts

      keywords.each do |keyword|
        puts "    PM_KEYWORD(#{keyword.inspect}, '#{keyword[0]}', '#{keyword[keyword.length / 2]}', '#{keyword[-1]}', ...)"
      end
    end

    # bin/prism lex [source]
    def lex(argv)
      source, filepath = read_source(argv)
      prism = Prism.lex(source, filepath: filepath)
      max_token_type_length = prism.value.max_by { |token,| token.type.length }[0].type.length

      prism.value.each do |token,|
        loc = token.location
        puts(format(
          "%-#{max_token_type_length + 1}s(%s,%s)-(%s,%s) %s",
          token.type, loc.start_line, loc.start_column, loc.end_line, loc.end_column, token.value.inspect
        ))
      end
    end

    # bin/prism lex_compat [source]
    def lex_compat(argv)
      require "ripper"
      source, filepath = read_source(argv)

      ripper_value = Ripper.lex(source)
      prism_compat = Prism.lex_compat(source, filepath: filepath)
      prism = Prism.lex(source, filepath: filepath)

      if prism_compat.failure?
        puts "Errors lexing:"

        prism_compat.errors.map do |error|
          print "- [#{error.location.start_line},#{error.location.start_column}-"
          print "#{error.location.end_line},#{error.location.end_column}] "
          puts "\e[1;31m#{error.message}\e[0m"
        end

        puts "\n"
      end

      pattern = "%-64s %-64s %-64s"
      puts pattern % ["Ripper lex", "Prism compat lex", "Prism lex"]
      puts pattern % ["-" * 64, "-" * 64, "-" * 64]

      prism_compat_value = prism_compat.value
      prism_value = prism.value

      [ripper_value.length, prism_compat_value.length, prism_value.length].max.times do |index|
        parts = [ripper_value[index], prism_compat_value[index], nil]

        unless prism_value[index].nil?
          prism_token = prism_value[index][0]
          location = prism_token.location
          parts[2] = [[location.start_line, location.start_column], prism_token.type, location.slice]
        end

        if parts[0] != parts[1]
          puts "\033[1;31m#{pattern}\033[0m" % parts.map(&:inspect)
        elsif ENV["VERBOSE"]
          puts "\033[38;5;102m#{pattern}\033[0m" % parts.map(&:inspect)
        end
      end
    end

    # bin/prism locals [source]
    def locals(argv)
      source, _ = read_source(argv)

      puts "CRuby:"
      p Debug.cruby_locals(source)

      puts "Prism:"
      p Debug.prism_locals(source)
    end

    # bin/prism parse [source]
    def parse(argv)
      result = parse_source(argv)

      parts = {}
      parts["Comments"] = result.comments if result.comments.any?
      parts["Magic comments"] = result.magic_comments if result.magic_comments.any?
      parts["Warnings"] = result.warnings if result.warnings.any?
      parts["Errors"] = result.errors if result.errors.any?
      parts["DATA"] = result.data_loc if result.data_loc

      if parts.empty?
        puts result.value.inspect
      else
        parts["AST"] = result.value
        parts.each_with_index do |(key, value), index|
          puts if index > 0
          puts "#{key}:"
          pp value
        end
      end
    end

    # bin/prism parser [source]
    def parser(argv)
      require "parser/current"
      source, filepath = read_source(argv)

      buffer = Parser::Source::Buffer.new(filepath, 1)
      buffer.source = source

      puts "Parser:"
      parser_parse(Parser::CurrentRuby.new, buffer)

      puts "Prism:"
      parser_parse(Prism::Translation::ParserCurrent.new, buffer)
    end

    # bin/prism ripper [source]
    def ripper(argv)
      require "ripper"
      source, _ = read_source(argv)

      ripper = Ripper.sexp_raw(source)
      prism = Prism::Translation::Ripper.sexp_raw(source)

      puts "Ripper:"
      pp ripper

      puts "Prism:"
      pp prism

      puts "Output is #{ripper == prism ? "" : "not "}identical"
    end

    # bin/prism rubyparser [source]
    def rubyparser(argv)
      require "ruby_parser"
      source, filepath = read_source(argv)

      ruby_parser = RubyParser.new.parse(source, filepath)
      prism = Prism::Translation::RubyParser.parse(source, filepath)

      puts "RubyParser:"
      pp ruby_parser

      puts "Prism:"
      pp prism
    end

    # bin/prism repl
    def repl
      loop do
        print "Prism> "

        input = gets
        break if input.nil?

        result = Prism.parse(input.chomp)

        statements_node = result.value.statements
        statements = statements_node.body

        result.errors.each { |e| p(e) }

        p(statements.one? ? statements.first : statements)
      end
    end

    ############################################################################
    # Helpers
    ############################################################################

    # Parse a Parser::Source::Buffer with a given parser.
    def parser_parse(parser, buffer)
      diagnostics = []
      parser.diagnostics.consumer = -> (diagnostic) { diagnostics << diagnostic }

      parser_ast, _, parser_tokens = parser.tokenize(buffer, true)
      pp diagnostics if diagnostics.any?
      pp parser_ast
      pp parser_tokens
    end

    # Return true if a name that starts with the given character is a constant
    # name. Object.const_defined? raises a NameError for a name that is not.
    # This is more than [[:upper:]]: in an encoding that is not Unicode, a
    # character that is neither uppercase nor lowercase begins a constant if
    # case folding changes it, as Windows-1252 does to the multiplication sign.
    def constant_start?(character)
      Object.const_defined?(character)
      true
    rescue NameError
      false
    end

    # Generate the list of values that will be used in a lookup table for a
    # given encoding.
    def lookup_table_values(encoding)
      (0...256).each_slice(16).map.with_index do |slice, row_index|
        slice.map do |codepoint|
          character = codepoint.chr(encoding)

          values = 0
          values |= (1 << 0) if character.match?(/[[:alpha:]]/)
          values |= (1 << 1) if character.match?(/[[:alnum:]]/)
          values |= (1 << 2) if constant_start?(character)
          values
        rescue RangeError
          0
        end
      end
    end

    # Generate a lookup table for a given encoding.
    def lookup_table(encoding)
      encoding_values = lookup_table_values(encoding)
      if encoding_values == lookup_table_values(Encoding::US_ASCII)
        puts "static const uint8_t pm_encoding_ascii_table[256] = {"
      else
        puts "static const uint8_t pm_encoding_#{encoding.name.downcase}_table[256] = {"
      end

      puts "//  #{(0...16).map { |value| value.to_s(16).upcase }.join("  ")}"
      encoding_values.each_with_index do |row, row_index|
        puts "    #{row.join(", ")}, // #{row_index.to_s(16).upcase}x"
      end
      puts "};"
    end

    # The version of Unicode that each version of Ruby that prism supports
    # uses, from oldest to newest. The functions in src/encoding.c that take a
    # version of Ruby answer for its version of Unicode from what this
    # generates.
    RUBY_UNICODE_VERSIONS = {
      "3.3" => "15.0.0",
      "3.4" => "15.0.0",
      "4.0" => "17.0.0",
      "4.1" => "17.0.0"
    }

    # The version of the Unicode Character Database that the unicode tables
    # are generated from. It is the newest version that any version of Ruby
    # that prism supports uses.
    UNICODE_VERSION = RUBY_UNICODE_VERSIONS.values.max_by { |version| Gem::Version.new(version) }

    # The older versions of Unicode that versions of Ruby that prism supports
    # use, from oldest to newest. The functions that answer for those versions
    # of Ruby check lists of the characters whose properties differ from the
    # tables.
    UNICODE_OLDER_VERSIONS =(RUBY_UNICODE_VERSIONS.values.uniq - [UNICODE_VERSION]).sort_by { |version| Gem::Version.new(version) }

    # Read a file of the Unicode Character Database at the given version. Each
    # file is downloaded once from unicode.org and kept in tmp/unicode.
    def unicode_data(path, version = UNICODE_VERSION)
      cache = File.expand_path("../tmp/unicode/#{version}/#{path}", __dir__)

      unless File.exist?(cache)
        require "fileutils"
        require "net/http"

        uri = URI("https://www.unicode.org/Public/#{version}/ucd/#{path}")
        response = Net::HTTP.get_response(uri)
        raise "could not download #{uri}: #{response.code} #{response.message}" unless response.is_a?(Net::HTTPSuccess)

        FileUtils.mkdir_p(File.dirname(cache))
        File.write(cache, response.body)
      end

      File.read(cache)
    end

    # Return the codepoints that have the given property in the given file of
    # the Unicode Character Database at the given version. Each line of the
    # file gives a codepoint or a range of codepoints and a property, as in
    # "0041..005A ; Uppercase".
    def unicode_property(path, property, version = UNICODE_VERSION)
      codepoints = []

      unicode_data(path, version).each_line do |line|
        fields = line.sub(/#.*/, "").split(";").map(&:strip)
        next unless fields.length == 2 && fields[1] == property

        low, high = fields[0].split("..").map { |value| Integer(value, 16) }
        codepoints.concat((low..(high || low)).to_a)
      end

      raise "no codepoints have #{property} in #{path} at #{version}" if codepoints.empty?
      codepoints
    end

    # Return the codepoints that can begin a constant name in the given version
    # of Unicode: those with the Uppercase property, as in [[:upper:]], and the
    # titlecase letters (Lt).
    def unicode_uppercase(version = UNICODE_VERSION)
      unicode_property("DerivedCoreProperties.txt", "Uppercase", version) |
        unicode_property("extracted/DerivedGeneralCategory.txt", "Lt", version)
    end

    # Generate the multistage lookup tables of unicode codepoint properties
    # for a given encoding. A codepoint's properties live in the leaf table,
    # reached by indexing the root table with its high bits and the middle
    # table with its next five bits. Identical middle and leaf blocks are
    # shared, which is what keeps the tables small.
    #
    # The tables mark the codepoints that are uppercase in the Unicode
    # Character Database at UNICODE_VERSION: those with the Uppercase property,
    # as in [[:upper:]], and the titlecase letters (Lt), since either can begin
    # a constant name. Every other character that is not ASCII is an identifier
    # character, so the tables need no other properties.
    #
    # Older versions of Ruby use an older version of Unicode, in which some
    # of the uppercase letters of the tables are not uppercase. Another bit
    # marks those letters, so that the tables answer for every version of
    # Ruby that prism supports.
    def unicode_lists
      raise "one bit marks the letters of one older version of Unicode, but there are #{UNICODE_OLDER_VERSIONS.length}" unless UNICODE_OLDER_VERSIONS.length == 1

      older = UNICODE_OLDER_VERSIONS.first
      older_bit = "PM_UNICODE_#{older.split(".").first}_NOT_UPPERCASE_BIT"
      latest_uppercase = unicode_uppercase
      older_uppercase = unicode_uppercase(older)
      raise "uppercase in Unicode #{older} but not #{UNICODE_VERSION}: #{(older_uppercase - latest_uppercase).inspect}" unless (older_uppercase - latest_uppercase).empty?

      values = Array.new(0x110000, 0)

      latest_uppercase.each { |codepoint| values[codepoint] |= (1 << 2) }
      (latest_uppercase - older_uppercase).each { |codepoint| values[codepoint] |= (1 << 3) }

      names = { 0 => "N", 4 => "U", 12 => "V" }
      unknown = values.uniq - names.keys
      raise "unnamed property values: #{unknown.inspect}" if unknown.any?

      maximum = values.rindex { |value| value != 0 } + 1
      maximum = (maximum + 0xFF) & ~0xFF

      leaf_blocks, leaf_indices = unicode_blocks(values[0...maximum].each_slice(8).to_a, 0)
      middle_blocks, root = unicode_blocks(leaf_indices.each_slice(32).to_a, leaf_indices.first)

      raise "too many unique blocks" if leaf_blocks.length > 256 || middle_blocks.length > 256

      puts "\n#define UNICODE_CODEPOINTS_MAXIMUM 0x#{maximum.to_s(16).upcase}"

      puts "\nstatic const uint8_t pm_unicode_root[#{root.length}] = {"
      root.each_slice(16).with_index do |slice, index|
        puts "    /* U+%05X */ %s," % [index * 16 * 256, slice.map { |value| "0x%02X" % value }.join(", ")]
      end
      puts "};"

      puts "\nstatic const uint8_t pm_unicode_middle[#{middle_blocks.length}][32] = {"
      middle_blocks.each_with_index do |block, index|
        puts "    [0x%02X] = { %s }," % [index, block.map { |value| "0x%02X" % value }.join(", ")]
      end
      puts "};"

      tables_ruby = RUBY_UNICODE_VERSIONS.find { |_, version| version == UNICODE_VERSION }.first
      tables_update = "PM_UNICODE_TABLES_#{UNICODE_VERSION.split(".").first}_UPDATE"
      versions = RUBY_UNICODE_VERSIONS.group_by(&:last).map { |version, rubies| " * * Ruby #{rubies.map(&:first).join(" and ")} use Unicode #{version}." }

      puts <<~C

        /**
         * The version of Ruby that updated its version of Unicode to #{UNICODE_VERSION}.
         *
        #{versions.join("\n")}
         */
        #define #{tables_update} PM_OPTIONS_VERSION_CRUBY_#{tables_ruby.tr(".", "_")}

        /**
         * The unicode tables use the fourth bit of each property byte to mark the
         * letters that are uppercase or titlecase in the tables but not in Unicode
         * #{older}, which the versions of Ruby before #{tables_update}
         * use.
         */
        #define #{older_bit} (1 << 3)

        /* Not uppercase. */
        #define N 0

        /* An uppercase or titlecase letter. */
        #define U (PRISM_ENCODING_UPPERCASE_BIT)

        /* An uppercase or titlecase letter that is not one in Unicode #{older}. */
        #define V (PRISM_ENCODING_UPPERCASE_BIT | #{older_bit})
      C

      puts "\nstatic const uint8_t pm_unicode_leaf[#{leaf_blocks.length}][8] = {"
      leaf_blocks.each_with_index do |block, index|
        puts "    [0x%02X] = { %s }," % [index, block.map { |value| names.fetch(value) }.join(", ")]
      end
      puts "};"

      puts "\n#undef N\n#undef U\n#undef V"
    end

    # Deduplicate the given blocks. The block made entirely of the given empty
    # value is numbered 0 and the rest are numbered from most to least used,
    # so the tables that index them read as long runs of small numbers.
    # Returns the unique blocks and the index of each original block.
    def unicode_blocks(blocks, empty)
      tally = blocks.tally
      unique = tally.keys.sort_by.with_index { |block, index| [block.all?(empty) ? 0 : 1, -tally[block], index] }
      indices = unique.each_with_index.to_h
      [unique, blocks.map { |block| indices[block] }]
    end

    # Parse the source code indicated by the command-line arguments.
    def parse_source(argv)
      command_line = +""
      command_line << argv.shift[1] while argv.first&.match?(/^-[alnpx]$/)

      case argv.first
      when "-e"
        command_line << argv.shift[1]
        Prism.parse(argv.shift, command_line: command_line)
      when nil
        Prism.parse_file("test.rb", command_line: command_line)
      else
        Prism.parse_file(argv.shift, command_line: command_line)
      end
    end

    # Get the source code indicated by the command-line arguments.
    def read_source(argv)
      case argv.first
      when "-e"
        argv.shift
        [argv.shift, "-e"]
      when nil
        [File.read("test.rb"), "test.rb"]
      else
        filepath = argv.shift
        [File.read(filepath), filepath]
      end
    end
  end
end

Prism::CLI.new.run(ARGV)
